# Generated automatically in ~/Hermes/.env (not this repository).
# Paths are absolute and reflect the local user and home directory.
HERMES_UID=1000
HERMES_GID=1000
HERMES_DATA_DIR=/home/example/Hermes/data/.hermes
HERMES_AGENT_SRC=/home/example/Hermes/agent-src
HERMES_WORKSPACES=/home/example/Hermes/workspaces
# An unconfigured installation shows an empty placeholder instead of all projects.
HERMES_ACTIVE_PROJECT=_inactive
HERMES_ACTIVE_WORKSPACE=/home/example/Hermes/idle-workspace
HERMES_TOOLS_HOME=/home/example/Hermes/tools
WEBUI_PORT=8787
WEBUI_IMAGE=ghcr.io/nesquena/hermes-webui@sha256:<from-versions.lock>
